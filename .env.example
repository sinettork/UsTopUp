NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_FRONTEND_PREVIEW=true
# Server-only key used for trusted payment verification. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Bakong merchant account and Open API token. Start with the SIT sandbox endpoint.
BAKONG_API_BASE_URL=https://sit-api-bakong.nbc.gov.kh
BAKONG_ACCESS_TOKEN=your-bakong-access-token
BAKONG_ACCOUNT_ID=your-bakong-account-id
BAKONG_MERCHANT_NAME=Your registered merchant name
BAKONG_MERCHANT_CITY=PHNOM PENH
# ABA PayWay. Use the sandbox host until ABA whitelists your domain.
ABA_PAYWAY_API_BASE_URL=https://checkout-sandbox.payway.com.kh
ABA_PAYWAY_MERCHANT_ID=your-payway-merchant-id
ABA_PAYWAY_API_KEY=your-payway-api-key
# Public HTTPS site URL, with no path. PayWay must whitelist this domain.
APP_BASE_URL=https://your-domain.example
